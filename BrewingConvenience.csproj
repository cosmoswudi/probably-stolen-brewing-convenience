<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <!-- 游戏是 Unity 2021.3，运行时只支持到 C# 9；不要改成 latest -->
    <LangVersion>9.0</LangVersion>
    <AssemblyName>BrewingConvenience</AssemblyName>
    <RootNamespace>BrewingConvenience</RootNamespace>
    <Nullable>disable</Nullable>
    <NoWarn>CS0169;CS0414;CS0649</NoWarn>
    <!-- 游戏目录：默认假设本项目位于 <游戏目录>\Modding\BrewingConvenience\ -->
    <GameDir>$(MSBuildProjectDirectory)\..\..</GameDir>
    <ManagedDir>$(GameDir)\Probably Stolen_Data\Managed</ManagedDir>
    <ModInstallDir>$(GameDir)\Mods\BrewingConvenience</ModInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(ManagedDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 随 mod 发布的文件：清单 + 资源目录（文件夹名必须精确，扫描不递归） -->
  <ItemGroup>
    <ModFile Include="manifest.xml;preview.png;Textures\**;Sounds\**;Localization\**;LootTables\**;Books\**" />
    <None Remove="Textures\**;Sounds\**;Localization\**;LootTables\**;Books\**" />
  </ItemGroup>

  <!-- 每次构建后把 dll 与清单/资源安装到 <游戏目录>\Mods\BrewingConvenience\ -->
  <!-- 注意：必须用 %(RelativeDir) 而不是 %(RecursiveDir)。RecursiveDir 会吞掉
       "Textures\" / "Localization\" 这一层前缀，把文件摊平到根目录，
       而游戏扫描资源是「路径精确、不递归」的，摊平后就等于没装。 -->
  <Target Name="InstallMod" AfterTargets="Build">
    <MakeDir Directories="$(ModInstallDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModInstallDir)" />
    <Copy SourceFiles="@(ModFile)" DestinationFolder="$(ModInstallDir)\%(RelativeDir)" Condition="Exists('%(ModFile.FullPath)')" />
    <Message Importance="high" Text="Installed into $(ModInstallDir)" />
  </Target>

</Project>
